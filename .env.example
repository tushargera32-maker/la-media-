# --- Database: libSQL / Turso ---
# From the Turso dashboard, or `turso db show <name>` and `turso db tokens create <name>`.
DATABASE_URL="libsql://your-db-name-org.turso.io"
DATABASE_AUTH_TOKEN=""

# For local development against a plain SQLite file instead, use:
# DATABASE_URL="file:./dev.db"      (leave DATABASE_AUTH_TOKEN empty)

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""                  # openssl rand -base64 32

# --- Seed credentials (used once by: npm run db:seed) ---
# There is no default password. Seeding fails without one, by design.
ADMIN_EMAIL="admin@lamedia.in"
ADMIN_PASSWORD=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="LA Media & Communications"

# --- Email (Resend) ---
# Domain lamedia.co.in is verified in Resend (SPF + DKIM).
# Friendly-name format is accepted as-is, e.g. "LA Media <noreply@lamedia.co.in>".
RESEND_API_KEY=""
NOTIFICATION_EMAIL=""
FROM_EMAIL="LA Media <noreply@lamedia.co.in>"

# --- WhatsApp lead alerts (Meta Cloud API, optional) ---
# If unset, alerts are skipped silently and forms keep working.
# WHATSAPP_TO is the admin's number, digits with country code (e.g. 919888078580).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TO=""
WHATSAPP_TEMPLATE_NAME="stall_lead_alert"
WHATSAPP_TEMPLATE_LANG="en"

# --- Cashfree (paid consultation) ---
# From Cashfree Dashboard → Developers → API Keys. Never commit real keys.
CASHFREE_ENV="sandbox"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
NEXT_PUBLIC_CASHFREE_ENV="sandbox"
